FROM node:24-alpine

WORKDIR /app

COPY tools/keeper/package.json tools/keeper/package-lock.json ./tools/keeper/
RUN npm ci --prefix tools/keeper --omit=dev

COPY tools/keeper ./tools/keeper
# The keeper parses its config through the shared BOM-safe reader.
COPY tools/lib ./tools/lib
COPY config/keeper-v2.mainnet.json \
  config/keeper-v2-live.mainnet.json \
  config/keeper-public-v2.mainnet.json \
  config/keeper-fullscale-v3.template.json \
  config/keeper.mainnet.json \
  config/robinhood-mainnet-stage4-deployment.json \
  config/stage4-deployment-manifest.json \
  ./config/

RUN npm test --prefix tools/keeper

ENV NODE_ENV=production
ENV KEEPER_CONFIG_PATH=config/keeper-v2.mainnet.json
ENV KEEPER_SECONDARY_CONFIG_PATH=config/keeper-public-v2.mainnet.json
ENV KEEPER_STATE_PATH=/data/keeper-v2-alerts.json
EXPOSE 8080

CMD ["node", "tools/keeper/daemon.mjs"]
