FROM node:24-alpine

WORKDIR /app

COPY tools/keeper/package.json tools/keeper/package-lock.json ./tools/keeper/
RUN npm ci --prefix tools/keeper --omit=dev

COPY tools/keeper ./tools/keeper
# The keeper parses its config through the shared BOM-safe reader.
COPY tools/lib ./tools/lib
COPY config/keeper.mainnet.json \
  config/robinhood-mainnet-stage4-deployment.json \
  config/stage4-deployment-manifest.json \
  ./config/

RUN npm test --prefix tools/keeper

ENV NODE_ENV=production
EXPOSE 8080

CMD ["node", "tools/keeper/daemon.mjs", "--config", "config/keeper.mainnet.json", "--state", "/data/keeper-alerts.json"]
