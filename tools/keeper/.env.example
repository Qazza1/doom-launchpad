# Copy this file to tools/keeper/.env. Never commit the real token.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token

# Run `npm run telegram:setup --prefix tools/keeper` after sending /start to
# your bot. The helper prints this value.
TELEGRAM_CHAT_ID=replace_after_setup

# Public RPCs are acceptable for initial read-only tests. Use a dedicated
# primary and fallback RPC before the mainnet canary.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_FALLBACK_RPC_URL=
